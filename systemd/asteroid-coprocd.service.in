[Unit]
Description=AsteroidOS coprocessor daemon

[Service]
Type=dbus
BusName=org.asteroid.Coprocessor
ExecStart=@CMAKE_INSTALL_FULL_BINDIR@/asteroid-coprocd
Restart=on-failure

[Install]
WantedBy=default.target
