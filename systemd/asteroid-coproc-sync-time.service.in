[Unit]
Description=Sync the coprocessor time
Requires=asteroid-coprocd.service
After=asteroid-coprocd.service

[Service]
Type=oneshot
ExecStart=@CMAKE_INSTALL_FULL_BINDIR@/asteroid-coproc --sync-time
